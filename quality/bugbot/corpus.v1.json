      "expected": [{ "id": "goroutine-leak", "title": "Producer blocks after timeout", "file": "internal/fetch.go", "line": 64, "severity": "medium", "category": "reliability", "symbol": "FetchWithTimeout", "codeSnippet": "results <- fetch(ctx)" }]
    },
