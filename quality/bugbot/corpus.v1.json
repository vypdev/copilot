    {
      "id": "ts-null-dereference",
      "language": "typescript",
      "category": "correctness",
      "description": "A changed optional lookup is dereferenced without a guard.",
      "file": "src/users.ts",
      "startLine": 41,
      "diff": "+const user = users.find(item => item.id === id);\n+return user.name;",
      "expected": [{ "id": "unchecked-user", "title": "Optional lookup result is dereferenced", "file": "src/users.ts", "line": 42, "severity": "medium", "category": "correctness", "symbol": "getUserName", "codeSnippet": "return user.name" }]
    },
    {
      "id": "py-command-injection",
      "language": "python",
      "category": "security",
      "description": "Untrusted input is interpolated into a shell command.",
      "file": "app/image.py",
      "startLine": 18,
      "diff": "+os.system(f\"convert {request.args['file']} out.png\")",
      "expected": [{ "id": "shell-injection", "title": "Request input reaches a shell", "file": "app/image.py", "line": 18, "severity": "high", "category": "security", "symbol": "convert_image", "codeSnippet": "os.system(f\"convert {request.args['file']} out.png\")" }]
    },
