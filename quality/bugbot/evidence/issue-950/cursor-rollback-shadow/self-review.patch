-        context: action.scm.context,
+        context: {
+            ...action.scm.context,
+            async getReviewDiffSnapshot(number, expectedHead) {
+                assert.equal(number, plan.pullRequest);
+                assert.equal(expectedHead, plan.headSha);
+                const snapshot = await action.scm.context.getReviewDiffSnapshot(number, expectedHead);
+                if (snapshot.coverage.status !== 'complete') return snapshot;
+                const supplemented = [];
+                const changes = snapshot.value.changes.map(change => {
+                    if (change.status !== 'modified' || change.patch || change.additions || change.deletions
+                        || fileMatchesIgnorePatterns(change.filename, plan.ignored)) return change;
+                    const counts = localCounts.get(change.filename);
+                    if (!counts?.some(count => count > 0)) return change;
+                    const [additions, deletions] = counts;
+                    supplemented.push({ path: change.filename, additions, deletions });
+                    return { ...change, additions, deletions };
+                });
+                log({ event: 'missing-diff-counters', headSha: expectedHead, supplemented });
+                return { ...snapshot, value: { ...snapshot.value, changes } };
+            },
+        },
