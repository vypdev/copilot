+    // The native inventory and all supplied patches and counters stay authoritative.
+    // For an empty modified entry only, derive the missing counters from the
+    // exact comparison so the ordinary framed adapter can verify the local patch.
+    const localCounts = new Map();
+    const numstat = git(checkout, '--no-replace-objects', 'diff', '--no-ext-diff', '--no-textconv',
+        '--no-renames', '--text', '--diff-algorithm=myers', '--no-indent-heuristic',
+        '--numstat', '-z', plan.baseSha, plan.headSha, '--');
+    for (const row of numstat.split('\0')) {
+        const parsed = /^(\d+)\t(\d+)\t([^\r\n]+)$/u.exec(row);
+        if (parsed) localCounts.set(parsed[3], [Number(parsed[1]), Number(parsed[2])]);
+    }
