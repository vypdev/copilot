ows immediately. Transactions explicitly enable foreign keys; SQLite's foreign-key parent-key requirement makes this a real invalid composite parent-key route, not just a naming concern.","missing":null,"citations":[{"kind":"git","sha":"e129e76e25deff7314efe3b72996d295cf73f7f3","path":"backend/src/domus/infrastructure/sqlite_member_profile_schema.py","blob":"372ee3be7d23cd02b6657a98fc98a84d529cf136","first":4,"last":18,"receipt":"Rdd14a7e134325a8edeca8942","inChangedLines":false,"unchangedFile":true,"textSha256":"e55e07f9636e62071c488f108ef2c00aadcb48742aaa588598841dbf6d327573"},{"kind":"git","sha":"e129e76e25deff7314efe3b72996d295cf73f7f3","path":"backend/src/domus/infrastructure/sqlite.py","blob":"44c5d7d1c2326f4105ba9fe387488c6309992720","first":67,"last":73,"receipt":"R03b233d9ded5f9dd3f97cd68","inChangedLines":false,"unchangedFile":true,"textSha256":"9054202ed4f6dcfd25195f24e6e3260730cd9ca560fb580115f61c7a757914fc"},{"kind":"git","sha":"e129e76e25deff7314efe3b72996d295cf73f7f3","path":"backend/src/domus/infrastructure/sqlite_identity.py","blob":"9e18a400d110347f853b7609956bce110d163f50","first":82,"last":102,"receipt":"R9b56ab80649fd9b748ebf890","inChangedLines":false,"unchangedFile":true,"textSha256":"8d7cc3dfdf19af04965626d3a8536d9c1860832fda720b7825e9a23fa9c37755"},{"kind":"git","sha":"e129e76e25deff7314efe3b72996d295cf73f7f3","path":"backend/src/domus/infrastructure/sqlite.py","blob":"44c5d7d1c2326f4105ba9fe387488c6309992720","first":399,"last":416,"receipt":"Rc982cb91b0fa255b37db3eb8","inChangedLines":false,"unchangedFile":true,"textSha256":"7fb02fefe92ea3f0dab3b043dc42579d56dd0180d7dd1b3f7dbe1b6c278758df"}],"id":"sqlite_member_profile_schema:8:invalid-composite-parent-key","candidate":{"id":"sqlite_member_profile_schema:8:invalid-composite-parent-key","hypothesis":"Profile foreign keys reference a non-unique composite key","anchor":{"path":"backend/src/domus/infrastructure/sqlite_member_profile_schema.py","line":8,"end":8,"side":"RIGHT"},"repository":{"ow