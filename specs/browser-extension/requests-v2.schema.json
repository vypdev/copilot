{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vypdev.github.io/copilot/specs/browser-extension/requests-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repositoryId",
    "producerActorId",
    "commands"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "repositoryId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "producerActorId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "contexts",
          "requiresWriteActor",
          "requiresVerifiedBranch",
          "effect",
          "agent"
        ],
        "properties": {
          "name": {
            "enum": [
              "help",
              "plan",
              "clarify",
              "estimate",
              "test-plan",
              "explain",
              "diagnose",
              "analyze",
              "review",
              "findings",
              "recheck",
              "sdd-diff",
              "status",
              "doctor",
              "history",
              "description",
              "fix",
              "dismiss",
              "implement",
              "remember",
              "sync-branch"
            ]
          },
          "contexts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "enum": [
                "conversation",
                "review-thread"
              ]
            }
          },
          "requiresWriteActor": {
            "type": "boolean"
          },
          "requiresVerifiedBranch": {
            "type": "boolean"
          },
          "effect": {
            "enum": [
              "files",
              "finding-state",
              "pr-description",
              "publication"
            ]
          },
          "agent": {
            "enum": [
              "never",
              "conditional",
              "may-run"
            ]
          }
        }
      }
    }
  }
}
